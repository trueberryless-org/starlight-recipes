  "license": "MIT",
  "description": "Starlight plugin to create a recipe website.",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./components/MarkdownContent.astro": "./components/starlight/MarkdownContent.astro",
