---
import type { Locale } from "../../libs/i18n";
import { getGridCells } from "../../libs/smart-grid";
import type { StarlightRecipeEntry } from "../../libs/types";
import Preview from "./Preview.astro";

interface Props {
  entries: StarlightRecipeEntry[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<div class="mobile-only">
  {entries.map((entry) => (
    <Preview {entry} {locale} />
  ))}
</div>

<div class="desktop-only grid">
  {getGridCells(entries).map(({ entry, isFeatured, isFullWidth }) => (
    <div class={isFullWidth ? "span-full" : "span-half"}>
      <Preview {entry} {locale} bigPreview={isFeatured} />
    </div>
  ))}
</div>

<style>
  .desktop-only {
    display: none;
  }

  @media (min-width: 500px) {
    .mobile-only {
      display: none;
    }
    .desktop-only {
      display: grid;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .grid > div {
      margin-top: 0;
    }

    .span-full {
      grid-column: span 2;
    }

    .span-half {
      grid-column: span 1;
    }
  }
</style>
