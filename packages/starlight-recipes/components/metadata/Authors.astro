---
import { getEntryAuthors } from "../../libs/authors";
import { getRating } from "../../libs/rating";
import type { StarlightRecipeEntry } from "../../libs/types";
import Author from "./Author.astro";
import Rating from "./Rating.astro";

interface Props {
  entry: StarlightRecipeEntry;
}

const { entry } = Astro.props;
const authors = getEntryAuthors(entry);
const rating = getRating(entry.data.rating);
---

{authors.length > 0 || rating ? (
  <div class="authors-meta not-content">
    {authors.length > 0 && (
      <div class="authors">
        {authors.map((author) => (
          <Author {author} />
        ))}
      </div>
    )}
    {rating && <Rating {rating} />}
  </div>
) : null}

<style>
  .authors-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
  }

  .authors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .authors-meta :global(.rating) {
    flex-shrink: 0;
    margin-block-start: 0.5rem;
  }

  @media print {
    .authors {
      gap: 0.75rem;
    }
  }
</style>
